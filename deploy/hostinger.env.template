# SUMENEP · Environment variables untuk Web App Hostinger (sumenep.matamaduranews.com)
#
# TEMPLATE TANPA SECRET. Cara pakai (Tahap E, setelah disetujui):
#   1. Salin ke komputer Anda sebagai berkas lain (JANGAN di repository), isi nilai <…>.
#   2. hPanel → Websites → sumenep.matamaduranews.com → Environment variables →
#      "Import .env" (atau tambah satu per satu). PERHATIAN: menyimpan
#      Environment variables langsung me-redeploy Web App (dokumentasi Hostinger).
#   3. Hapus salinan berkas berisi password itu dari komputer setelah diimpor.
#
# Variabel ini KHUSUS Web App SUMENEP. Jangan dipasang di website WordPress.

# ── Situs ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://sumenep.matamaduranews.com
# Tetap "staging" (noindex + robots Disallow) sampai peluncuran disetujui.
NEXT_PUBLIC_SITE_ENV=staging

# ── Database MariaDB SUMENEP (BUKAN database WordPress) ─────────────────────
# Dari hPanel → Databases → Management. Password ditulis apa adanya (tidak perlu
# URL-encode); host boleh "localhost" (aplikasi memakai 127.0.0.1). Saat server
# start, aplikasi sendiri yang membuat tabel di database yang masih kosong
# (prisma migrate deploy) dan data awal — lihat src/server/deploy/auto-setup.ts.
# Database yang berisi tabel lain (mis. WordPress) ditolak tanpa diubah.
DATABASE_URL=mysql://<DB_USER>:<DB_PASSWORD>@localhost:3306/<DB_NAME>
# DIRECT_URL dan DB_APP_USER TIDAK dipasang di Web App (hanya untuk operator).

# ── Akun Admin pertama (dibuat otomatis saat start, hanya bila belum ada) ────
# Password minimal 15 karakter. Hapus ADMIN_PASSWORD setelah login pertama;
# Admin yang sudah ada tidak pernah diubah oleh variabel ini.
ADMIN_EMAIL=<email admin>
ADMIN_PASSWORD=<password admin, min. 15 karakter>
# ADMIN_NAME=Admin SUMENEP

# ── Media di disk Hostinger (di luar hbuilds/ dan public_html) ───────────────
# Tidak perlu diisi: bawaan production ~/sumenep-data/media, dibuat otomatis.
# MEDIA_ROOT=/home/<HOSTINGER_USERNAME>/sumenep-data/media

# ── CMS ──────────────────────────────────────────────────────────────────────
CMS_PUBLIC_ARTICLES=on
CMS_CACHE_SECONDS=60

# ── Proxy/CDN Hostinger (hcdn) ───────────────────────────────────────────────
# Diverifikasi saat Tahap E (header IP klien yang dikirim hcdn).
TRUSTED_PROXY_COUNT=1
CLIENT_IP_HEADER=
ADMIN_ALLOWED_HOSTS=

# ── Tidak dipakai di Hostinger (biarkan TIDAK ada) ───────────────────────────
# S3_ENDPOINT, S3_BUCKET, S3_REGION, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY,
# R2_PUBLIC_URL, DIRECT_URL, DB_APP_USER, DB_APP_ROLE

# SUMENEP · Akses operator ke Hostinger untuk scripts/ops/hostinger-remote-check.mjs
#
# Salin menjadi .env.hostinger-db.local di root proyek (git-ignored). Isi di editor
# teks Anda sendiri; jangan kirim isinya ke chat, jangan commit. Kosongkan
# password (atau hapus berkas ini) setelah Tahap E.

# SSH (hPanel -> Advanced -> SSH Access): username dan host akun hosting yang
# sudah ada. Harus sama dengan yang tertulis di kartu "SSH details".
HOSTINGER_SSH=u123456789@srvNNN.hstgr.io
HOSTINGER_SSH_PORT=65002
# Hanya subdomain SUMENEP; skrip menolak domain lain.
HOSTINGER_DOMAIN=sumenep.matamaduranews.com

# Database SUMENEP (hPanel -> Databases -> Management, daftar "List of Current
# MySQL Databases And Users"). Salin PERSIS dari hPanel: nama user bisa berbeda
# dari nama database. Keduanya harus diawali nama akun hosting (u123456789_).
# BUKAN database WordPress.
HOSTINGER_DB_NAME=u123456789_sumenep
HOSTINGER_DB_USER=
# Password apa adanya (tanpa URL-encode, tanpa tanda kutip).
HOSTINGER_DB_PASSWORD=

# Tujuan tunnel di sisi server (dokumentasi Hostinger: aplikasi Node.js memakai 127.0.0.1).
HOSTINGER_DB_HOST_FROM_SERVER=127.0.0.1

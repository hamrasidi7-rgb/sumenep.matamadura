{
  "name": "sumenep-matamadura",
  "version": "0.1.0",
  "private": true,
  "description": "SUMENEP – Mata Madura · media editorial sumenep.matamaduranews.com",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev -p 3200",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "qa:shots": "node scripts/shoot.mjs",
    "brand:build": "node scripts/build-brand.mjs",
    "demo:media": "node scripts/prepare-demo-media.mjs",
    "qa:articles": "node scripts/qa-articles.mjs",
    "qa:export": "node scripts/export-screenshots.mjs",
    "start:local": "next start -p 3200",
    "db:setup": "node scripts/db/dev-db.mjs setup",
    "db:start": "node scripts/db/dev-db.mjs start",
    "db:stop": "node scripts/db/dev-db.mjs stop",
    "db:status": "node scripts/db/dev-db.mjs status",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:migrate:dev": "prisma migrate dev --skip-seed",
    "postdb:migrate:dev": "tsx scripts/db/grants.ts",
    "db:grants": "tsx scripts/db/grants.ts",
    "db:seed": "tsx scripts/db/seed.ts",
    "db:verify": "tsx scripts/db/verify.ts",
    "db:triggers": "tsx scripts/db/triggers.ts",
    "admin:bootstrap": "tsx scripts/admin/bootstrap.ts",
    "admin:recover": "tsx scripts/admin/recover.ts",
    "prod:smoke": "node scripts/prod/smoke.mjs",
    "hosting:check": "node scripts/ops/hostinger-remote-check.mjs --env-file .env.hostinger-db.local --trigger-test --backup-test",
    "backup": "node scripts/ops/backup.mjs",
    "restore": "node scripts/ops/restore.mjs",
    "test": "npm run test:unit && npm run test:db",
    "test:unit": "tsx --test \"tests/unit/*.test.ts\"",
    "test:db": "tsx scripts/test/run-db-tests.ts",
    "test:e2e": "tsx scripts/test/run-e2e-tests.ts",
    "test:backup": "tsx scripts/test/run-backup-test.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1175.0",
    "@prisma/adapter-mariadb": "6.19.3",
    "@prisma/client": "6.19.3",
    "@tailwindcss/postcss": "4.3.5",
    "@tiptap/core": "2.27.3",
    "@tiptap/extension-link": "2.27.3",
    "@tiptap/extension-underline": "2.27.3",
    "@tiptap/pm": "2.27.3",
    "@tiptap/react": "2.27.3",
    "@tiptap/starter-kit": "2.27.3",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "lucide-react": "1.66.0",
    "mariadb": "3.4.5",
    "next": "16.4.6",
    "prisma": "6.19.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "playwright-core": "1.65.1",
    "tsx": "4.23.15"
  }
}

# dependencies & build output
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# secrets — never commit (only .env.example is tracked)
.env
.env.*
!.env.example

# local PostgreSQL instance, database backups, CMS uploads
.data/
backups/

# ── Situs ─────────────────────────────────────────────────────────────────────
# URL kanonik. Produksi: https://sumenep.matamaduranews.com
NEXT_PUBLIC_SITE_URL=http://localhost:3200
# "production" = boleh diindeks mesin pencari. Nilai lain (default) = staging:
# seluruh halaman diberi noindex dan robots.txt menolak semua crawler.
NEXT_PUBLIC_SITE_ENV=staging

# ── Chator AI (MataGen.ai) ───────────────────────────────────────────────────
# Diisi setelah endpoint tenant SUMENEP di console-matagen-ai disetujui dan
# dibuat (Tahap 6). Selama kosong, widget menampilkan status "belum tersambung"
# dan TIDAK membuat jawaban sendiri. Kunci hanya dipakai di server (/api/chator).
MATAGEN_CHAT_URL=
MATAGEN_CHAT_API_KEY=

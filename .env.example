# ── Situs ─────────────────────────────────────────────────────────────────────
# URL kanonik. Produksi: https://sumenep.matamaduranews.com
NEXT_PUBLIC_SITE_URL=http://localhost:3200
# "production" = boleh diindeks mesin pencari. Nilai lain (default) = staging:
# seluruh halaman diberi noindex dan robots.txt menolak semua crawler.
NEXT_PUBLIC_SITE_ENV=staging

# ── Database CMS (PostgreSQL 16 / Neon Launch Singapore) ────────────────────────
# Development: JANGAN isi manual. `npm run db:setup` membuat PostgreSQL lokal
# yang terisolasi dan menulis .env + .env.test dengan password acak.
# Produksi: gunakan Neon Launch Singapore (region aws-ap-southeast-1).
#   - DATABASE_URL diisi di Hostinger Web App (Environment variables),
#     memakai endpoint pooler Neon (`-pooler`) + role runtime hak minimum (`DB_APP_ROLE`).
#   - DIRECT_URL + DB_APP_ROLE HANYA dipakai di komputer operator untuk migrasi
#     dan skrip CLI (`npm run db:migrate`, `db:seed`, `admin:bootstrap`, `admin:recover`),
#     memakai endpoint direct Neon (non-pooler). JANGAN pasang DIRECT_URL di web runtime.
#   - Wajib TLS/SSL (`sslmode=verify-full`) dan sesi timezone UTC.
#   - Jangan gunakan database WordPress, development, Busacare, atau MataGen.
#
# Role runtime aplikasi (hanya SELECT/INSERT/UPDATE/DELETE; tanpa DDL).
DATABASE_URL=postgresql://sumenep_app:GANTI@127.0.0.1:54329/sumenep_cms_dev?schema=public
# Role pemilik: migrasi Prisma + skrip CLI. Di produksi pakai &sslmode=verify-full.
DIRECT_URL=postgresql://sumenep_owner:GANTI@127.0.0.1:54329/sumenep_cms_dev?schema=public
# Nama role runtime di atas; dipakai `npm run db:grants` untuk mengatur hak akses.
DB_APP_ROLE=sumenep_app

# ── CMS di balik proxy / CDN Hostinger (opsional; lihat docs/08 & INFRASTRUCTURE.md)
# Host tambahan yang dianggap "situs ini" untuk pemeriksaan Origin (CSRF),
# dipisah koma. Kosongkan bila proxy meneruskan host publik (`sumenep.matamaduranews.com`).
ADMIN_ALLOWED_HOSTS=
# IP klien untuk batas login per IP: jumlah proxy tepercaya yang menambah
# X-Forwarded-For (default 1), atau header IP khusus dari platform.
TRUSTED_PROXY_COUNT=1
CLIENT_IP_HEADER=

# ── CMS artikel (Fase 4) ──────────────────────────────────────────────────────
# "on" = /artikel/[slug] lebih dulu mencari artikel TERBIT di database CMS, lalu
# konten contoh. Daftar (beranda, kanal, rubrik) tetap konten contoh s.d. Fase 8.
CMS_PUBLIC_ARTICLES=
# Lama data artikel publik disimpan di cache server (detik, default 60). Setiap
# perubahan dari CMS langsung membersihkan cache; artikel terjadwal tampil paling
# lambat sekian detik setelah waktunya.
CMS_CACHE_SECONDS=60

# ── Media Storage (Cloudflare R2 S3-compatible di production) ─────────────────
# Development/test: "local". Produksi: wajib "s3" (Cloudflare R2; dilarang LocalStorage).
MEDIA_DRIVER=local
# Hanya dipakai bila MEDIA_DRIVER=local (development/test).
MEDIA_ROOT=media
# Kredensial Cloudflare R2 (bucket khusus SUMENEP; isi di Hostinger hPanel, bukan Git).
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Opsional: custom domain publik R2 bila bucket dibuka untuk akses publik (mis. https://media.sumenep.matamaduranews.com).
# Bila dikosongkan, gambar disajikan lewat rute aplikasi /media/<key>.
R2_PUBLIC_URL=

# Chator AI: integrasi MataGen.ai DITUNDA (proyek terpisah). Widget hanya
# menampilkan status "sedang dalam pengembangan"; tidak ada variabel AI.

# ── Situs ─────────────────────────────────────────────────────────────────────
# URL kanonik. Produksi: https://sumenep.matamaduranews.com
NEXT_PUBLIC_SITE_URL=http://localhost:3200
# "production" = boleh diindeks mesin pencari. Nilai lain (default) = staging:
# seluruh halaman diberi noindex dan robots.txt menolak semua crawler.
NEXT_PUBLIC_SITE_ENV=staging

# ── Database CMS (PostgreSQL 16) ──────────────────────────────────────────────
# Development: JANGAN isi manual. `npm run db:setup` membuat PostgreSQL lokal
# yang terisolasi dan menulis .env + .env.test dengan password acak.
# Produksi: diisi di panel Hostinger (variabel lingkungan), tidak pernah di Git.
#
# Role runtime aplikasi (hanya SELECT/INSERT/UPDATE/DELETE; tanpa DDL).
DATABASE_URL=postgresql://sumenep_app:GANTI@127.0.0.1:54329/sumenep_cms_dev?schema=public
# Role pemilik: migrasi Prisma + skrip CLI (bootstrap/recover/seed). Tidak
# dipakai web app saat runtime. Di produksi tambahkan &sslmode=verify-full.
DIRECT_URL=postgresql://sumenep_owner:GANTI@127.0.0.1:54329/sumenep_cms_dev?schema=public
# Nama role runtime di atas; dipakai `npm run db:grants` untuk mengatur hak akses.
DB_APP_ROLE=sumenep_app

# ── CMS di balik proxy (opsional; lihat docs/08-autentikasi-admin.md) ─────────
# Host tambahan yang dianggap "situs ini" untuk pemeriksaan Origin (CSRF),
# dipisah koma. Kosongkan bila proxy meneruskan host publik.
ADMIN_ALLOWED_HOSTS=
# IP klien untuk batas login per IP: jumlah proxy tepercaya yang menambah
# X-Forwarded-For (default 1), atau header IP khusus dari platform.
TRUSTED_PROXY_COUNT=1
CLIENT_IP_HEADER=

# ── CMS artikel (Fase 4) ──────────────────────────────────────────────────────
# "on" = /artikel/[slug] lebih dulu mencari artikel TERBIT di database CMS, lalu
# konten contoh. Daftar (beranda, kanal, rubrik) tetap konten contoh s.d. Fase 8.
CMS_PUBLIC_ARTICLES=
# Lama data artikel publik disimpan di cache server (detik, default 60). Setiap
# perubahan dari CMS langsung membersihkan cache; artikel terjadwal tampil paling
# lambat sekian detik setelah waktunya.
CMS_CACHE_SECONDS=
# Folder gambar unggahan (driver lokal). Produksi memakai object storage (Fase 6).
MEDIA_ROOT=media

# Chator AI: integrasi MataGen.ai DITUNDA (proyek terpisah). Widget hanya
# menampilkan status "sedang dalam pengembangan"; tidak ada variabel AI.

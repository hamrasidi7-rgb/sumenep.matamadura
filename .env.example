# ── Situs ─────────────────────────────────────────────────────────────────────
# URL kanonik. Produksi: https://sumenep.matamaduranews.com
NEXT_PUBLIC_SITE_URL=http://localhost:3200
# "production" = boleh diindeks mesin pencari. Nilai lain (default) = staging:
# seluruh halaman diberi noindex dan robots.txt menolak semua crawler.
NEXT_PUBLIC_SITE_ENV=staging

# ── Database CMS (MariaDB Hostinger) ─────────────────────────────────────────
# Development: JANGAN isi manual. `npm run db:setup` membuat MariaDB lokal yang
# terisolasi (.data/mariadb) dan menulis .env + .env.test dengan password acak.
# Produksi: database MariaDB khusus SUMENEP di hPanel → Databases (BUKAN database
# WordPress). Format: mysql://USER:PASSWORD@HOST:3306/DATABASE (password di-URL-encode).
#   - DATABASE_URL diisi di hPanel → Web App SUMENEP → Environment variables.
#     Dari server Hostinger sendiri host-nya biasanya "localhost" (lihat hPanel).
#   - DIRECT_URL HANYA dipakai di komputer operator / SSH untuk migrasi dan skrip
#     CLI (`npm run db:migrate`, `db:seed`, `db:verify`, `admin:bootstrap`,
#     `admin:recover`). JANGAN pasang DIRECT_URL di Web App.
#   - Koneksi remote (Remote MySQL hPanel): tambahkan ?ssl=true bila server mendukung TLS.
#   - Hostinger memberi satu user per database: DATABASE_URL dan DIRECT_URL boleh
#     memakai user yang sama (mode satu user). Bila tersedia user kedua untuk
#     database yang sama, isi DB_APP_USER dengan user runtime itu agar
#     `npm run db:grants` membatasi haknya (tanpa UPDATE/DELETE Activity Log, tanpa DDL).
#   - Sesi selalu UTC (diatur aplikasi per koneksi).
#
# User runtime (dipakai website).
DATABASE_URL=mysql://sumenep_app:GANTI@127.0.0.1:33069/sumenep_cms_dev
# User pemilik: migrasi Prisma + skrip CLI.
DIRECT_URL=mysql://sumenep_owner:GANTI@127.0.0.1:33069/sumenep_cms_dev
# User runtime terpisah (opsional). Kosong atau sama dengan user DIRECT_URL = mode satu user.
DB_APP_USER=sumenep_app

# ── CMS di balik proxy / CDN Hostinger (opsional; lihat docs/08 & INFRASTRUCTURE.md)
# Host tambahan yang dianggap "situs ini" untuk pemeriksaan Origin (CSRF),
# dipisah koma. Kosongkan bila proxy meneruskan host publik (`sumenep.matamaduranews.com`).
ADMIN_ALLOWED_HOSTS=
# IP klien untuk batas login per IP: jumlah proxy tepercaya yang menambah
# X-Forwarded-For (default 1), atau header IP khusus dari platform.
TRUSTED_PROXY_COUNT=1
CLIENT_IP_HEADER=

# ── CMS artikel (Fase 4) ──────────────────────────────────────────────────────
# "on" = /artikel/[slug] lebih dulu mencari artikel TERBIT di database CMS, lalu
# konten contoh. Daftar (beranda, kanal, rubrik) tetap konten contoh s.d. Fase 8.
CMS_PUBLIC_ARTICLES=
# Lama data artikel publik disimpan di cache server (detik, default 60). Setiap
# perubahan dari CMS langsung membersihkan cache; artikel terjadwal tampil paling
# lambat sekian detik setelah waktunya.
CMS_CACHE_SECONDS=60

# ── Media (disk Hostinger) ────────────────────────────────────────────────────
# "local" (default): berkas di disk pada MEDIA_ROOT. "s3": OPSIONAL, bucket
# S3-compatible (mis. Cloudflare R2) — bukan ketergantungan produksi.
MEDIA_DRIVER=local
# Development/test: boleh relatif (default "media", di-ignore Git).
# Produksi: WAJIB path absolut di LUAR direktori aplikasi (redeploy mengganti
# direktori aplikasi), mis. /home/<user>/domains/sumenep.matamaduranews.com/sumenep-media
# Bila MEDIA_ROOT kosong, relatif, atau di dalam aplikasi/.next, operasi media ditolak (pesan jelas di log).
MEDIA_ROOT=media
# Hanya bila MEDIA_DRIVER=s3 (opsional; kosongkan di produksi Hostinger).
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Opsional: domain publik bucket. Kosong = gambar disajikan lewat /media/<key>.
R2_PUBLIC_URL=

# Chator AI: integrasi MataGen.ai DITUNDA (proyek terpisah). Widget hanya
# menampilkan status "sedang dalam pengembangan"; tidak ada variabel AI.
